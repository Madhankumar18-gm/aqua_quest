PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aquaquest?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Configuration
# Defaults in Development: API=200/15m, Auth=60/15m, Submission=60/1m
# Defaults in Production:  API=200/15m, Auth=10/15m, Submission=10/1m
RATE_LIMIT_API_MAX=200
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_SUBMISSION_MAX=60

# Default Admin Credentials for Seeding (Placeholders)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

